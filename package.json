{
  "name": "0xbot-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && tsc --noEmit && prettier --check app src next.config.ts",
    "format": "prettier --write app src next.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
